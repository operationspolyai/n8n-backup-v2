        "query": "SELECT \n  m.id AS \"memberID\",\n  m.created_at AS \"memberCreatedAt\",\n  m.name AS \"memberName\",\n  m.email,\n  m.phone_number AS \"memberPhoneNumber\",\n  m.\"ClickUpID\" AS \"memberClickUpID\",\n  m.\"sentDepartmentEmail\",\n  r.\"roleName\",\n  d.id AS \"departmentID\",\n  d.created_at AS \"departmentCreatedAt\",\n  d.\"departmentName\",\n  d.emoji,\n  d.\"ClickUpAssignOtherListID\",\n  d.\"ClickUpFolderID\",\n  d.\"driveID\",\n  d.gmail,\n  d.password,\n  d.\"phoneNumber\" AS \"departmentPhoneNumber\",\n  d.\"backupCodes\",\n  d.\"GoogleAuthenticatorKey\"\nFROM public.\"Members\" m\nLEFT JOIN public.\"MemberDepartment\" md ON m.id = md.\"memberID\"\nLEFT JOIN public.\"Department\" d ON md.\"departmentID\" = d.id\nLEFT JOIN public.\"MemberRole\" mr ON m.id = mr.\"memberID\"\nLEFT JOIN public.\"Role\" r ON mr.\"roleID\" = r.id\nWHERE m.id = {{ $json.id }};",
